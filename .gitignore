# ═══════════════════════════════════════════════════════════════════════════════
#  .gitignore — management-tire (Monorepo: Backend + Desktop + Mobile)
# ═══════════════════════════════════════════════════════════════════════════════


# ── İşletim Sistemi ───────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/


# ── Editör / IDE ──────────────────────────────────────────────────────────────
.idea/
.vscode/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~
.history/


# ══════════════════════════════════════════════════════════════════════════════
#  GÜVENLİK — Hiçbir gizli değer repoya girmez
# ══════════════════════════════════════════════════════════════════════════════
.env
**/.env
.envrc
*.key
*.pem
*.p12
*.pfx
secrets.json
credentials.json


# ══════════════════════════════════════════════════════════════════════════════
#  BACKEND — Python / FastAPI
# ══════════════════════════════════════════════════════════════════════════════

# Sanal ortam
backend/.venv/
.venv/

# Python derleme çıktıları
__pycache__/
*.py[cod]
*.pyo
*$py.class
*.so

# Dağıtım / paketleme
dist/
build/
*.egg-info/
*.egg
.eggs/
MANIFEST

# Test & coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/

# Log dosyaları
*.log
backend/logs/


# ══════════════════════════════════════════════════════════════════════════════
#  DESKTOP — PyQt6
# ══════════════════════════════════════════════════════════════════════════════

# Sanal ortam
desktop/.venv/

# PyInstaller build çıktısı
desktop/build/
desktop/dist/
desktop/**/*.spec

# Qt derleme çıktısı
*.qm


# ══════════════════════════════════════════════════════════════════════════════
#  MOBILE — Flutter / Dart
# ══════════════════════════════════════════════════════════════════════════════

# Dart araç dizini
mobile/.dart_tool/
.dart_tool/

# Flutter build çıktısı
mobile/build/

# Pub cache
.pub-cache/
.pub/

# Flutter plugin dosyaları (otomatik üretilir)
mobile/.flutter-plugins
mobile/.flutter-plugins-dependencies
.flutter-plugins
.flutter-plugins-dependencies

# Dart analiz
mobile/.packages

# Android build
mobile/android/.gradle/
mobile/android/app/debug/
mobile/android/app/profile/
mobile/android/app/release/
mobile/android/local.properties
mobile/android/key.properties
mobile/android/app/*.jks
mobile/android/app/*.keystore

# iOS build
mobile/ios/.symlinks/
mobile/ios/Flutter/flutter_export_environment.sh
mobile/ios/Flutter/Generated.xcconfig
mobile/ios/Pods/
mobile/ios/Runner.xcworkspace/xcshareddata/
mobile/ios/**/*.mode1v3
mobile/ios/**/*.mode2v3
mobile/ios/**/*.perspectivev3

# Obfuscation / symbolication
app.*.symbols
app.*.map.json

# Test coverage
mobile/coverage/


# ══════════════════════════════════════════════════════════════════════════════
#  DB / SCRIPTS
# ══════════════════════════════════════════════════════════════════════════════

# DB dump'ları (büyük dosyalar, gizli veri içerebilir)
*.sql.gz
*.dump
db/backups/
