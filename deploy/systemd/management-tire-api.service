[Unit]
Description=Dijital Lastik Servisi — FastAPI Backend
After=network.target mariadb.service
Wants=mariadb.service

[Service]
Type=exec
User=mgmttire
Group=mgmttire
WorkingDirectory=/opt/management-tire/backend
EnvironmentFile=/opt/management-tire/backend/.env
ExecStart=/opt/management-tire/backend/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal
SyslogIdentifier=management-tire-api

[Install]
WantedBy=multi-user.target
